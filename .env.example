###############################################################
#  Kiss My Flowers — Environment variables
#  Copy this file to `.env.local` and fill in the values.
#  On Vercel: add each one under Project → Settings → Environment Variables.
###############################################################

# ──────────────────────────────────────────────────────────
#  TIER 0 — Storefront only (browse catalog, add to cart)
#  Works with NOTHING set. Catalog/prices come from lib/catalog.ts.
# ──────────────────────────────────────────────────────────

# Public site URL (no trailing slash). Used for Stripe redirects + SEO.
# Local: http://localhost:3000   Production: https://kissmyflowers.bg
NEXT_PUBLIC_APP_URL=

# ──────────────────────────────────────────────────────────
#  TIER 1 — Required to actually PLACE & PAY for orders
# ──────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # secret — server only, never expose

# Stripe (Dashboard → Developers → API keys)
STRIPE_SECRET_KEY=                # sk_live_... (or sk_test_... while testing)
STRIPE_WEBHOOK_SECRET=            # whsec_... from the webhook endpoint you create

# ──────────────────────────────────────────────────────────
#  TIER 2 — Staff dashboards (/admin and /hub)
#  PIN = what staff type to log in. TOKEN = random secret stored in cookie.
# ──────────────────────────────────────────────────────────
ADMIN_PIN=                        # e.g. 4–8 digits
ADMIN_TOKEN=                      # long random string (openssl rand -hex 24)
HUB_PIN=
HUB_TOKEN=

# Protects all /api/cron/* endpoints. Vercel sends this automatically.
CRON_SECRET=                      # long random string

# ──────────────────────────────────────────────────────────
#  TIER 3 — Automated dispatch / notifications (optional at launch)
# ──────────────────────────────────────────────────────────

# WhatsApp Cloud API (Meta for Developers)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=    # you invent this; paste same value in Meta console
WHATSAPP_ADMIN_PHONE=359888123456 # admin phone for reports (digits only, no +)

# Viber Bot (optional alternative dispatcher channel)
VIBER_BOT_TOKEN=
VIBER_DISPATCHER_ID=

# Address geocoding + delivery-zone check (openrouteservice.org, free tier).
# If empty, geo-validation is skipped (all Burgas addresses accepted).
OPENROUTESERVICE_API_KEY=

# ──────────────────────────────────────────────────────────
#  TIER 4 — AI back-office agents (optional)
#  Accountant / Lawyer / Marketing cron reports + RAG search.
# ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=                   # embeddings for the knowledge base

# ──────────────────────────────────────────────────────────
#  TIER 5 — Crypto-paywalled premium analytics API (optional, advanced)
# ──────────────────────────────────────────────────────────
POLYGON_RPC_URL=
BASE_RPC_URL=
CRYPTO_DESTINATION_WALLET=
