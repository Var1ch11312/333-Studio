    {
      "parameters": {
        "jsCode": "// Разбор входящего сообщения, роль и контроль доступа\nconst body = $input.first().json;\nconst msg = body.message || body.edited_message || {};\nconst from = msg.from || {};\nconst chatId = (msg.chat && msg.chat.id) || from.id;\nlet text = (msg.text || msg.caption || '').trim();\n\n// Не-текстовые сообщения: агент попросит прислать текст\nif (!text) {\n  const kind = msg.photo ? 'фото' : msg.voice ? 'голосовое' : msg.document ? 'документ' : msg.sticker ? 'стикер' : 'вложение';\n  text = `[пользователь прислал ${kind} без текста]`;\n}\n\n// === НАСТРОЙКА ДОСТУПА ===\nconst ADMINS = [488686339];        // владелец / админ\nconst MANAGERS = [];               // сюда добавляйте Telegram ID менеджеров\n\nconst allowed = [...ADMINS, ...MANAGERS];\nconst authorized = allowed.length === 0 ? true : allowed.includes(from.id);\nconst role = ADMINS.includes(from.id) ? 'admin' : 'manager';\nconst managerName = [from.first_name, from.last_name].filter(Boolean).join(' ') || String(from.id);\n\nreturn [{ json: { chatId, text, userId: from.id, managerName, role, authorized } }];"
      },
